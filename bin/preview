#!/usr/bin/env bash
# fzf preview: live terminal content for the selected tree row.
# argv: $1 = target ("ws:<workspace_id>" | "tab:<tab_id>")
set -uo pipefail
HERDR="${HERDR_BIN_PATH:-herdr}"
target="${1:-}"
[[ -z $target ]] && exit 0

kind="${target%%:*}"
id="${target#*:}"

case "$kind" in
    ws)  ws="$id"       ; tab="" ;;
    tab) ws="${id%%:*}" ; tab="$id" ;;
    *)   exit 0 ;;
esac

# Resolve which panes to show: a tab's panes, else the workspace's active tab.
panes=$("$HERDR" pane list --workspace "$ws" 2>/dev/null | TAB="$tab" python3 -c '
import sys, json, os
want = os.environ.get("TAB") or ""
try:
    panes = json.load(sys.stdin).get("result", {}).get("panes", [])
except Exception:
    sys.exit(0)
if want:
    panes = [p for p in panes if p.get("tab_id") == want]
for p in panes[:3]:
    print("%s\t%s" % (p.get("pane_id", ""), p.get("label") or ""))
')

[[ -z ${panes//[[:space:]]/} ]] && { printf '  \033[38;5;245m(no panes)\033[0m\n'; exit 0; }

while IFS=$'\t' read -r pid plabel; do
    [[ -z $pid ]] && continue
    printf '\033[38;5;245m┌─ \033[38;5;109m%s\033[0m %s\033[38;5;245m\033[0m\n' \
        "$pid" "${plabel:+$plabel }"
    "$HERDR" pane read "$pid" 2>/dev/null | tail -14 | sed 's/^/  /'
    printf '\n'
done <<< "$panes"
