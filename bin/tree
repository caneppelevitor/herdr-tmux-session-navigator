#!/usr/bin/env bash
# Emits the choose-tree row model: "<target>\t<shortcut>\t<display>"
# target is "ws:<workspace_id>" or "tab:<tab_id>".
set -uo pipefail
HERDR="${HERDR_BIN_PATH:-herdr}"

# Collect workspaces + their tabs into one JSON doc, then render.
{
  "$HERDR" workspace list 2>/dev/null
  for wid in $("$HERDR" workspace list 2>/dev/null | python3 -c '
import sys, json
for w in json.load(sys.stdin).get("result", {}).get("workspaces", []):
    print(w.get("workspace_id", ""))
'); do
    "$HERDR" tab list --workspace "$wid" 2>/dev/null
  done
} | python3 -c '
import sys, json

RST   = "\033[0m"
DIM   = "\033[38;5;245m"
FG    = "\033[38;5;252m"
KEY   = "\033[38;5;109m"
NAME  = "\033[38;5;223m"
GREEN = "\033[38;5;108m"
YELL  = "\033[38;5;214m"
RED   = "\033[38;5;167m"

docs = []
dec = json.JSONDecoder()
buf = sys.stdin.read()
i = 0
while i < len(buf):
    while i < len(buf) and buf[i].isspace():
        i += 1
    if i >= len(buf):
        break
    obj, i = dec.raw_decode(buf, i)
    docs.append(obj)

workspaces, tabs_by_ws = [], {}
for d in docs:
    r = d.get("result", {})
    if "workspaces" in r:
        workspaces = r["workspaces"]
    elif "tabs" in r:
        for t in r["tabs"]:
            tabs_by_ws.setdefault(t.get("workspace_id"), []).append(t)

# tmux choose-tree shortcut order: 0-9, then M-a, M-b, ...
def shortcuts():
    for n in range(10):
        yield str(n), str(n)
    for c in "abcdefghijklmnopqrstuvwxyz":
        yield "alt-" + c, "M-" + c

def dot(status):
    return {"working": YELL + "*" + RST,
            "idle":    GREEN + "*" + RST,
            "blocked": RED   + "*" + RST}.get(status or "", DIM + "-" + RST)

sc = shortcuts()
rows = []
for w in workspaces:
    wid   = w.get("workspace_id", "")
    tabs  = tabs_by_ws.get(wid, [])
    label = w.get("label") or wid
    n     = w.get("tab_count", len(tabs))

    try:
        bind, disp = next(sc)
    except StopIteration:
        break
    attached = GREEN + " (attached)" + RST if w.get("focused") else ""
    head = "%s%-6s%s %s-%s %s%s%s: %s%d tab%s%s%s" % (
        DIM, "(%s)" % disp, RST, DIM, RST,
        NAME, label, RST, FG, n, "" if n == 1 else "s", RST, attached)
    rows.append(("ws:" + wid, bind, head))

    for idx, t in enumerate(tabs):
        try:
            bind, disp = next(sc)
        except StopIteration:
            break
        last   = idx == len(tabs) - 1
        elbow  = "└─>" if last else "├─>"
        mark   = "*" if t.get("focused") else ""
        tlabel = t.get("label") or str(t.get("number", ""))
        line = "%s%-6s%s %s%s%s %s%s: %s%s%s%s %s(%d pane%s)%s" % (
            DIM, "(%s)" % disp, RST, DIM, elbow, RST,
            FG, t.get("number", ""), RST, tlabel, GREEN + mark + RST, RST,
            DIM, t.get("pane_count", 0), "" if t.get("pane_count") == 1 else "s", RST)
        rows.append(("tab:" + t.get("tab_id", ""), bind, line))

for target, bind, disp in rows:
    print("%s\t%s\t%s" % (target, bind, disp))
'
