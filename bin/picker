#!/usr/bin/env bash
# tmux choose-tree style workspace/tab switcher.
# Runs inside a herdr plugin pane; exits (closing the pane) after switching.
set -uo pipefail

HERDR="${HERDR_BIN_PATH:-herdr}"
ROOT="${HERDR_PLUGIN_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

die() {
    printf '\n  \033[31msession-popup:\033[0m %s\n\n  press any key...\n' "$1" >&2
    read -rsn1 </dev/tty 2>/dev/null || sleep 5
    exit 1
}

command -v fzf >/dev/null || die "fzf not found in PATH ($PATH)"

rows=$("$ROOT/bin/tree")
[[ -z ${rows//[[:space:]]/} ]] && die "no workspaces returned by herdr"

# tmux choose-tree jump keys: pressing (0)..(9)/(M-a).. selects that row directly.
# Built from column 2 of the row model so the labels and binds never drift apart.
binds=()
idx=0
while IFS=$'\t' read -r _t bind _d; do
    idx=$((idx + 1))
    [[ -z $bind ]] && continue
    binds+=(--bind "${bind}:pos(${idx})+accept")
done <<< "$rows"

sel=$(printf '%s\n' "$rows" | fzf \
    --ansi --with-nth=3.. --delimiter=$'\t' \
    --height=100% --layout=reverse --info=inline --no-separator \
    --pointer='' --marker='' \
    --prompt='  ' \
    --header=$'  enter  switch     0-9/M-a  jump     esc  cancel\n' \
    --header-first \
    --highlight-line \
    --color='bg+:#d8a657,fg+:#1d2021,gutter:-1,header:#7c8377,info:#7c8377,prompt:#89b482,border:#4a5057,label:#7c8377' \
    --preview="'$ROOT/bin/preview' {1}" \
    --preview-window='down,62%,border-top,wrap' \
    --preview-label=' preview ' \
    "${binds[@]}" \
    | cut -f1)

[[ -z ${sel:-} ]] && exit 0

kind="${sel%%:*}"
id="${sel#*:}"
case "$kind" in
    ws)  exec "$HERDR" workspace focus "$id" >/dev/null ;;
    tab) exec "$HERDR" tab focus "$id" >/dev/null ;;
esac
